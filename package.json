
{
  "name": "collab-editor",
  "version": "1.0.0",
  "scripts": {
    "start": "npx esbuild frontend/editor.js --bundle --outfile=public/bundle.js --servedir=public",
    "build": "esbuild src/app.js --bundle --outfile=public/bundle.js",
    "serve": "vite --port 8080",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run src/",
    "test:unit:watch": "vitest src/",
    "test:integration": "playwright test tests/integration/",
    "test:e2e": "playwright test tests/e2e/",
    "test:e2e:headed": "playwright test tests/e2e/ --headed",
    "test:e2e:debug": "playwright test tests/e2e/ --debug",
    "test:security": "playwright test tests/e2e/security/",
    "test:performance": "playwright test tests/e2e/performance/",
    "test:collaboration": "playwright test tests/e2e/collaboration/",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:quick": "npm run test:unit && cd rust-server && cargo test && cd .. && go test ./...",
    "test:coverage": "vitest run --coverage src/",
    "test:report": "playwright show-report",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "wasm:build": "cd rust-wasm && wasm-pack build --target web --out-dir pkg",
    "wasm:test": "cd rust-wasm && cargo test",
    "rust:test": "cd rust-server && cargo test",
    "go:test": "go test -v ./...",
    "setup:test": "./scripts/setup-test-env.sh"
  },
  "dependencies": {
    "@automerge/automerge": "^2.2.8",
    "@automerge/automerge-repo": "^1.2.1",
    "@automerge/automerge-repo-network-websocket": "^1.2.1",
    "@automerge/automerge-repo-storage-indexeddb": "^1.2.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/rangeset": "^0.19.9",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.37.2",
    "cbor-x": "^1.6.0",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^16.3.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "jsdom": "^23.2.0",
    "prettier": "^3.6.2",
    "vite": "^4.5.0",
    "vitest": "^3.2.4"
  }
}
